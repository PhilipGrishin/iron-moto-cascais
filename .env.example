# Iron Custom Motors — environment template
# Copy to .env (gitignored) and fill in the secrets.
# This file lists only NAMES of credentials and where to obtain them.
# Actual values are not stored in git.

# -----------------------------------------------------------------------------
# Google Cloud — Places API key, used by the Cloudflare Worker that fetches
# Google reviews. The Worker stores the key as its own secret (`wrangler secret
# put GOOGLE_API_KEY`), so the value of GOOGLE_API_KEY is needed only when
# (re)deploying the Worker.
# Where to get it:
#   https://console.cloud.google.com/apis/credentials
#   Project owner: fg@abrisart.com
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare account that hosts the Worker `icm-reviews`.
# Needed for `wrangler login` / `wrangler deploy` in the `worker/` directory.
# Where to get it: dashboard.cloudflare.com (account ID is at the right-hand
# side of the URL after login).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# -----------------------------------------------------------------------------
# GitHub access — used by anyone who pushes to the repo.
# This is delivered via the GitHub Desktop or `gh` login, not via .env.
# The repo URL itself is not a secret. See HANDOFF.md for the exact URL.
GITHUB_REPO_URL=

# -----------------------------------------------------------------------------
# FormSubmit (lead form on /contact/).
# The endpoint is hardcoded in the form: https://formsubmit.co/<EMAIL>.
# To rotate/disable, log into the Gmail account.
# Where: Gmail credentials for Ironcustom.office@gmail.com.
FORMSUBMIT_INBOX_EMAIL=Ironcustom.office@gmail.com

# -----------------------------------------------------------------------------
# Google Analytics 4 — measurement ID is public (it ships in the HTML).
# Account access is owned by the GA4 property's owner email.
# Property name: Iron Custom Motors
GA4_MEASUREMENT_ID=G-D15BLYEKBN
GA4_OWNER_EMAIL=fg@abrisart.com

# -----------------------------------------------------------------------------
# Meta (Facebook) Pixel — the ID is public.
# Access is held by whoever owns the Meta Business account.
# As of 2026-05 the pixel is loaded after consent but not actively used.
META_PIXEL_ID=1708697916976439

# -----------------------------------------------------------------------------
# Google Reviews proxy — Cloudflare Worker URL (public, no secret).
# Configured in scripts/build/build_reviews_schema.py
REVIEWS_WORKER_URL=https://icm-reviews.vg-ab6.workers.dev/
REVIEWS_GOOGLE_PLACE_ID=ChIJ-5VQL2bPHg0R-Oj5dD0Ojhk
